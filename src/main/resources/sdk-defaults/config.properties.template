# Poletop Automation SDK ? Consumer Configuration Template
# Copy this file to your project's configuration/ directory as config.properties
# and fill in your environment-specific values.

# ?? Base URLs ????????????????????????????????????????????????????????????????
dev_base_url     = https://YOUR-DEV-URL/
tst_base_url     = https://YOUR-TST-URL/
stg_base_url     = https://YOUR-STG-URL/
nonprod_base_url = https://YOUR-NONPROD-URL/
prod_base_url    = https://YOUR-PROD-URL/

# ?? Browser ???????????????????????????????????????????????????????????????????
browser = chrome

# ?? Paths (relative to project root) ?????????????????????????????????????????
screenshotsDir = /test-output/screenshots/
extReportDir   = /test-output/reports/
testDataDir    = /src/test/resources/testData/
pathToCsvReport = /test-output/CSVReports/

# ?? Test Data Excel files ?????????????????????????????????????????????????????
dev_data_set     = TestData_DEV.xlsx
tst_data_set     = TestData_TST.xlsx
stg_data_set     = TestData_STG.xlsx
nonprod_data_set = TestData_NONPROD.xlsx
prod_data_set    = TestData_PROD.xlsx
