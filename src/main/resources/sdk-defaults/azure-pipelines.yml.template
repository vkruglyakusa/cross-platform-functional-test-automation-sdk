# azure-pipelines.yml.template
# -------------------------------------------------------------------
# Copy this file to your consumer project root as azure-pipelines.yml
# and replace every <PLACEHOLDER> with your actual values.
#
# Authentication: uses MavenAuthenticate@0 (recommended for CI/CD).
# No PAT storage required — ADO injects credentials automatically.
# See SDK-USER-GUIDE.md Section 4.1b for full details.
# -------------------------------------------------------------------

trigger:
  - trunk                         # <-- change to your default branch (main, master, etc.)

pool:
  vmImage: 'ubuntu-latest'        # or 'windows-latest'

variables:
  SYSTEM_ACCESSTOKEN: $(System.AccessToken)

steps:
  # -- 1. Authenticate the Azure Artifacts feed ----------------------------
  #    Injects credentials into ~/.m2/settings.xml before any mvn command.
  #    artifactsFeeds must match the <id> in your pom.xml <repositories>.
  #    Need an EXTERNAL (non-ADO) Maven repo too? Add `mavenServiceConnections:`
  #    alongside artifactsFeeds — see SDK-USER-GUIDE.md Section 4.1b.
  #    Feed in a different ADO project? Grant that project's Build Service
  #    account "Reader" on this feed (Section 4.1b "Cross-project feed access").
  - task: MavenAuthenticate@0
    displayName: 'Authenticate Azure Artifacts — functional-test-automation-sdk'
    inputs:
      artifactsFeeds: functional-test-automation-sdk

  # -- 2. Install Java 21 runtime ------------------------------------------
  #    SDK requires Java >=20; this template uses Java 21 because Maven@4 offers jdkVersionOption 1.21.
  - task: JavaToolInstaller@0
    displayName: 'Install Java 21'
    inputs:
      versionSpec: '21'
      jdkArchitectureOption: 'x64'
      jdkSourceOption: 'PreInstalled'

  # -- 3. Run tests --------------------------------------------------------
  #    continueOnError: true ensures publish steps run even on test failures.
  #    publishJUnitResults: false — we publish TestNG XML directly in step 5.
  - task: Maven@4
    displayName: 'Run regression suite'
    inputs:
      mavenPomFile: 'pom.xml'
      goals: 'test'
      options: >
        -Denvironment=stg
        -DbrowserName=chrome
        -Dheadless=true
        -Dsurefire.suiteXmlFiles=regression_suite.xml
      publishJUnitResults: false
      javaHomeOption: 'JDKVersion'
      jdkVersionOption: '1.21'
    continueOnError: true

  # -- 4. Filter TestNG results (remove runMode=N skips) -------------------
  #    Without this step ADO counts SKIPs as "Others" and reports ~79% pass
  #    rate even when every executed test passed (0 failures).
  #    This step removes SKIP nodes and corrects total/skipped attributes on
  #    both <test> and <testng-results> so ADO shows true pass rate.
  #    NOTE: Allure reads its own JSON artifacts — it still shows SKIPs correctly.
  - task: PowerShell@2
    displayName: 'Filter TestNG results (remove runMode=N skips from ADO report)'
    condition: always()
    continueOnError: true
    inputs:
      targetType: inline
      script: |
        $files = Get-ChildItem -Path "$(System.DefaultWorkingDirectory)" `
                               -Recurse -Filter "testng-results.xml" `
                               -ErrorAction SilentlyContinue
        if (-not $files) {
          Write-Host "No testng-results.xml found -- skipping filter"
          exit 0
        }
        foreach ($f in $files) {
          try {
            [xml]$doc = Get-Content $f.FullName -Raw

            # Snapshot BEFORE removal -- live XmlNodeList shifts index on every RemoveChild,
            # causing every other SKIP node to be silently missed without the snapshot.
            $skipped = @($doc.SelectNodes("//test-method[@status='SKIP']"))
            if ($skipped.Count -eq 0) {
              Write-Host "No SKIPs in $($f.Name) -- nothing to filter"
              continue
            }

            foreach ($n in $skipped) {
              $null = $n.ParentNode.RemoveChild($n)
            }

            # Fix totals on every <test> node (ADO reads these attributes directly)
            foreach ($testNode in $doc.SelectNodes("//test")) {
              $cur = [int]$testNode.GetAttribute("skipped")
              $testNode.SetAttribute("skipped", "0")
              $total = [int]$testNode.GetAttribute("total")
              $testNode.SetAttribute("total", [string]($total - $cur))
            }

            # Fix totals on root <testng-results> element
            $root = $doc.DocumentElement
            $rootSkipped = [int]$root.GetAttribute("skipped")
            $root.SetAttribute("skipped", "0")
            $rootTotal = [int]$root.GetAttribute("total")
            $root.SetAttribute("total", [string]($rootTotal - $rootSkipped))

            $doc.Save($f.FullName)
            Write-Host "Removed $($skipped.Count) SKIP entries from $($f.Name) -- new total: $($rootTotal - $rootSkipped)"

          } catch {
            Write-Warning "Failed to process $($f.FullName): $_"
          }
        }

  # -- 5. Publish TestNG results to ADO Tests tab --------------------------
  - task: PublishTestResults@2
    displayName: 'Publish TestNG results to ADO'
    condition: always()
    inputs:
      testResultsFormat: 'TestNG'
      testResultsFiles: '**/testng-results.xml'
      mergeTestResults: true
      failTaskOnFailedTests: true
      testRunTitle: 'Regression Suite — $(Build.BuildNumber)'

  # -- 6. Publish all test artifacts ---------------------------------------
  #    Covers screenshots, DOM dumps, logs, Allure JSON, accessibility reports.
  - task: PublishBuildArtifacts@1
    displayName: 'Publish test artifacts'
    condition: always()
    inputs:
      PathtoPublish: 'test-output'
      ArtifactName: 'test-output'
