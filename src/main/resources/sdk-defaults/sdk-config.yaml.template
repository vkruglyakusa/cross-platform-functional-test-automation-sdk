# ============================================================
# functional-test-automation-sdk Configuration File
# Copy this file to your project's configuration/ directory
# as sdk-config.yaml and fill in your values.
#
# IMPORTANT: Add configuration/sdk-config.yaml to .gitignore
#            if it contains sensitive API keys.
# ============================================================

# ------------------------------------------------------------
# Browser Settings
# ------------------------------------------------------------
browser:
  default: chrome                   # chrome | firefox | edge
  headless: false                   # true for CI environments
  windowSize: "1920x1080"
  pageLoadTimeoutSeconds: 30
  implicitWaitSeconds: 0            # keep 0; use explicit waits
  scriptTimeoutSeconds: 30
  chromeDriverPath: ""              # optional: absolute path to a local chromedriver binary
                                    # leave empty (default) to let WebDriverManager resolve
                                    # the latest version matching the installed Chrome browser
                                    # example: "C:/tools/chromedriver/chromedriver.exe"

# ------------------------------------------------------------
# Proxy Settings
# ------------------------------------------------------------
proxy:
  enabled: false
  host: ""                          # e.g. proxy.company.com or bcpxy.nycnet
  port: 8080
  username: ""
  password: ""
  noProxy: "localhost,127.0.0.1"    # JVM http.nonProxyHosts (pipe-separated on some JVMs)
  bypassList: "localhost;<-loopback>" # Chrome --proxy-bypass-list (semicolon-separated)

# ------------------------------------------------------------
# API Keys & External Services
# ------------------------------------------------------------
api:
  mailinator:
    apiKey: "YOUR_MAILINATOR_API_KEY"
    domain: "mailinator.com"
    privateDomain: true
    inboxPollIntervalSeconds: 3
    inboxPollTimeoutSeconds: 60
    inboxInitialWaitSeconds: 5      # wait before first poll to allow email delivery

  # ------------------------------------------------------------
  # API-testing module: com.test.automation.sdk.api.ApiTestBase, a standalone
  # (no WebDriver) base class for pure API test classes, built on RestAssured.
  # Base URLs follow the same "one otherwise-identical key per environment"
  # convention already used by TestBase.setBaseUrl(environment): set
  # api.baseUrl.<environment> (e.g. api.baseUrl.stg) for per-environment
  # overrides, falling back to the environment-neutral api.baseUrl below.
  # NEVER put a real secret/token value here -- api.authTokenEnvVar names an
  # ENVIRONMENT VARIABLE whose value is read at runtime instead.
  # ------------------------------------------------------------
  baseUrl: ""                       # environment-neutral fallback base URL      (-Dapi.baseUrl)
  # baseUrl.stg: "https://stg.example.com"     # per-environment override example (-Dapi.baseUrl.stg)
  authHeaderName: ""                # e.g. "Ocp-Apim-Subscription-Key" or "Authorization" (-Dapi.authHeaderName)
  authTokenEnvVar: ""                # name of the env var holding the token/key value     (-Dapi.authTokenEnvVar)
  connectionTimeoutMillis: 10000    # (-Dapi.connectionTimeoutMillis)
  readTimeoutMillis: 30000          # (-Dapi.readTimeoutMillis)
  logRequestsAndResponses: true     # capture request/response JSON as evidence   (-Dapi.logRequestsAndResponses)
  outputDirectory: "test-output/api"  # captured API payload evidence files       (-Dapi.outputDirectory)
  relaxedHttpsValidation: false     # opt-in only, for lower non-prod environments (-Dapi.relaxedHttpsValidation)

# ------------------------------------------------------------
# Logging Settings
# Log file paths should normally stay under reporting.logsDir below.
# ------------------------------------------------------------
logging:
  level: INFO                       # TRACE | DEBUG | INFO | WARN | ERROR
  sdkLogFile: "test-output/logs/sdk.log"      # should live under reporting.logsDir
  seleniumLogFile: "test-output/logs/selenium.log"
  browserLogFile: "test-output/logs/browser.log"
  enableSeleniumLogs: true
  enableBrowserConsoleLogs: true
  enableDriverLogs: false           # verbose chromedriver output

# ------------------------------------------------------------
# Screenshot Settings
# ------------------------------------------------------------
screenshots:
  captureOnFailure: true
  captureOnStep: false

# ------------------------------------------------------------
# Crawler / PageObjectGenerator Settings
# ------------------------------------------------------------
crawler:
  pageObject:
    package: "com.mycompany.automation.uiActions"    # target Java package for generated page objects
    outputDir: "src/main/java/com/mycompany/automation/uiActions/"  # relative path to write .java files

# ------------------------------------------------------------
# Mobile (Appium / Android / iOS) Settings
# Read via com.test.automation.sdk.mobile.config.MobileConfigReader,
# which delegates to this file's ConfigurationManager precedence chain
# (system property > env var > this file > default) for every key below.
# A standalone configuration/mobile-config.yaml is also supported but is
# a DEPRECATED, temporary compatibility path -- see
# configuration/mobile-config.yaml.example. New projects should configure
# Mobile settings here instead.
# ------------------------------------------------------------
appium:
  localUrl: "http://127.0.0.1:4723/"   # local Appium server URL (-Dappium.localUrl)

android:
  appPath: ""                          # absolute/relative path to the .apk under test (-Dandroid.appPath)
  automationName: "UiAutomator2"       # Appium automationName capability (-Dandroid.automationName)

ios:
  appPath: ""                          # absolute/relative path to the .app/.ipa under test (-Dios.appPath)
  automationName: "XCUITest"           # Appium automationName capability (-Dios.automationName)

# ------------------------------------------------------------
# Reporting / Output Directories
# All test artifacts land under these paths.
# Override any individual dir with the matching -D flag shown.
# ------------------------------------------------------------
reporting:
  screenshotsDir: "test-output/screenshots"     # failure + step screenshots     (-Dreporting.screenshotsDir)
  domDumpsDir:    "test-output/dom-dumps"        # DOM snapshots on failure        (-Dreporting.domDumpsDir)
  logsDir:        "test-output/logs"             # sdk / selenium / browser logs   (-Dreporting.logsDir)
  crawlerDir:     "test-output/crawler"          # locator discovery reports       (-Dreporting.crawlerDir)
  accessibilityDir: "test-output/accessibility"  # a11y JSON / Excel / HTML        (-Dreporting.accessibilityDir)
  gapOutputDir:   "docs/test-case-gaps"          # gap-report.md / blocker-report.md (-Dreporting.gapOutputDir)

  # ------------------------------------------------------------
  # OBS-9: Automatic Allure HTML report generation after execution.
  # Prerequisite: the Allure commandline must be installed and on PATH
  # (https://allurereport.org/docs/install/). If it isn't found, generation
  # is skipped with a clear log message -- test execution itself is never
  # affected either way (report generation and test pass/fail are separate
  # concerns). See SDK-USER-GUIDE.md, "Allure Reporting", for details.
  # ------------------------------------------------------------
  allure:
    enabled: true                    # master on/off switch                        (-Dreporting.allure.enabled)
    generateAfterExecution: true     # run `allure generate` once execution ends   (-Dreporting.allure.generateAfterExecution)
    # NEVER default this to true -- opening a browser must always be opt-in,
    # especially on Azure DevOps agents / Windows services / headless hosts.
    openAfterGeneration: false       # open the generated report locally after success (-Dreporting.allure.openAfterGeneration)
    resultsDirectory: "allure-results"  # where allure-testng writes raw results   (-Dreporting.allure.resultsDirectory)
    reportDirectory: "allure-report"    # where the generated static HTML site goes (-Dreporting.allure.reportDirectory)
    generationTimeoutSeconds: 120    # max time to wait for `allure generate`      (-Dreporting.allure.generationTimeoutSeconds)

  # ------------------------------------------------------------
  # Cross-run analytics event store: every execution event (test outcomes,
  # runtime self-healing heals/exhaustions, etc.) is appended as one JSON
  # line per run under analytics.directory. Powers pass-rate trend, flaky-test,
  # and healed-locator-frequency analysis across many runs via
  # com.test.automation.sdk.reporting.AnalyticsTrendReport -- something no
  # single-run Allure/Extent report can answer on its own. Write failures
  # never affect test execution (this reporter simply disables itself).
  # ------------------------------------------------------------
  analytics:
    enabled: true                    # master on/off switch                        (-Dreporting.analytics.enabled)
    directory: "test-output/analytics"  # one *.jsonl file written per run          (-Dreporting.analytics.directory)

  # ------------------------------------------------------------
  # Tier 3 (#9): automated RCA-to-fix bundle. On every test failure,
  # com.test.automation.sdk.reporting.RcaBundleWriter consolidates test
  # identity, the exception chain, evidence paths (screenshot/DOM dump), and
  # a fresh tail of reporting.logsDir/sdk.log into ONE JSON file under
  # rcaBundle.directory -- so a human or Copilot (see fix-failed-test.prompt.md)
  # never has to hunt down three separate artifacts before starting RCA.
  # Write failures never affect test execution (this writer simply skips itself).
  # ------------------------------------------------------------
  rcaBundle:
    enabled: true                       # master on/off switch                     (-Dreporting.rcaBundle.enabled)
    directory: "test-output/rca-bundles"  # one *.json file written per failure    (-Dreporting.rcaBundle.directory)
    logTailLines: 80                    # trailing sdk.log lines embedded per bundle (-Dreporting.rcaBundle.logTailLines)
    stackTraceFrames: 15                # leading stack frames per exception/cause (-Dreporting.rcaBundle.stackTraceFrames)

# ------------------------------------------------------------
# SDK v1.5.1: extended Web failure evidence -- screenshot, browser console log,
# and (opt-in) browser network trace. See SDK-USER-GUIDE.md Section 13.4.
# All evidence is attached to Allure/Extent and referenced from the RCA
# bundle (rcaBundle above) when present. A capture/attachment failure never
# fails the test; it only means that evidence entry is skipped.
# ------------------------------------------------------------
evidence:
  screenshot:
    enabled: true                       # (-Devidence.screenshot.enabled)
    attachToReports: true               # attach to Allure/Extent            (-Devidence.screenshot.attachToReports)
    # NOTE: screenshot capture-on-failure itself is governed by TestBase's existing
    # capture logic (unconditional on failure), not a separate captureOnFailure key.

  # Browser console log (JS errors/warnings). Supported on Chrome and Edge;
  # not reliably supported on Firefox (geckodriver limitation) -- capture is
  # fail-safe there and simply produces no artifact.
  browserConsole:
    enabled: true                       # (-Devidence.browserConsole.enabled)
    captureOnFailure: true              # (-Devidence.browserConsole.captureOnFailure)
    attachToReports: true               # (-Devidence.browserConsole.attachToReports)

  # Browser network trace evidence via Chrome DevTools Protocol (NOT a HAR
  # file -- this SDK does not claim HAR compliance; see SDK-USER-GUIDE.md
  # Section 13.4.3). Chrome/Edge only (no Firefox support). Disabled by
  # default -- can add overhead, produce large artifacts, and may capture
  # sensitive request/response data. The generated artifact
  # (`*_network-trace.json`) is a simplified, non-canonical network trace
  # (method/URL/headers/status/mimeType only -- no bodies, timings, or body
  # sizes). All CDP-version-specific code is isolated behind an internal
  # adapter seam (com.test.automation.sdk.evidence.network) so the pinned
  # CDP version can be replaced in a future release without touching the
  # rest of the evidence pipeline.
  network:
    enabled: false                      # (-Devidence.network.enabled)
    captureOnFailure: true              # (-Devidence.network.captureOnFailure)
    attachToReports: true               # (-Devidence.network.attachToReports)
    redactSensitiveData: true           # masks Authorization/Cookie/tokens/etc. (-Devidence.network.redactSensitiveData)
    maxEntries: 500                     # bounded in-memory buffer, oldest dropped (-Devidence.network.maxEntries)

# ------------------------------------------------------------
# SDK v1.5.1: WebEventListener.onError() reporting classification.
# NoSuchElementException is treated as a "non-terminal" listener event by
# default -- logged at DEBUG and NOT reported via ExecutionReporting.actionFailed(...),
# since it is routinely used by consumer code to probe for optional elements.
# This affects listener-level logging/reporting ONLY -- the listener does not
# alter exception propagation -- and a final TestNG test failure is still
# fully captured (screenshot/
# DOM/log/RCA) as usual. See SDK-USER-GUIDE.md Section 15.0 for details.
# ------------------------------------------------------------
webdriver:
  eventListener:
    nonTerminalExceptions: "org.openqa.selenium.NoSuchElementException"  # comma-separated FQCNs (-Dwebdriver.eventListener.nonTerminalExceptions)

# ------------------------------------------------------------
# Zero-config visual regression testing: TestBase.assertVisualMatch(checkpointName)
# captures a screenshot and compares it against a stored baseline using a
# tolerant pixel diff (com.test.automation.sdk.visual.ImageDiffEngine) -- no
# external visual-testing service required. The first check for a given
# checkpoint name saves the screenshot as the accepted baseline; baselines
# live under visual.baselineDirectory (default inside src/test/resources so
# they can be committed and code-reviewed like any other test asset).
# ------------------------------------------------------------
visual:
  enabled: true                              # master on/off switch                (-Dvisual.enabled)
  baselineDirectory: "src/test/resources/visual-baselines"  # accepted baselines   (-Dvisual.baselineDirectory)
  outputDirectory: "test-output/visual"       # actual/diff images from this run    (-Dvisual.outputDirectory)
  mismatchThresholdPercent: 0.1               # max acceptable mismatch % (0-100)   (-Dvisual.mismatchThresholdPercent)
  pixelColorTolerance: 12                     # per-channel (0-255) anti-aliasing tolerance (-Dvisual.pixelColorTolerance)
  # Set true only for a deliberate one-off re-baselining run after an
  # intentional UI change -- every checkpoint's baseline gets overwritten.
  updateBaselines: false                      # (-Dvisual.updateBaselines)
  failOnMismatch: true                        # throw AssertionError on mismatch    (-Dvisual.failOnMismatch)

# ------------------------------------------------------------
# Flaky-test quarantine: com.test.automation.sdk.flaky.FlakyTestQuarantineListener
# uses the cross-run analytics history above (reporting.analytics) to tell a
# genuinely intermittent test apart from a first-time regression or a test
# that is simply broken (failing almost every run). Declare the listener in
# your TestNG suite XML, AFTER com.test.automation.sdk.listener.Listener, so
# the real failure is still recorded in reports/analytics before this
# listener reclassifies the final TestNG result. Disabled by default --
# converting a failure into a skip is an opinionated behavior change a
# project must deliberately opt into.
# ------------------------------------------------------------
flaky:
  quarantine:
    enabled: false                       # master on/off switch                (-Dflaky.quarantine.enabled)
  minRunsForQuarantine: 5                # min historical runs before quarantine is allowed (-Dflaky.minRunsForQuarantine)
  maxFailureRatePercent: 80               # above this failure rate the test is "broken", not flaky (-Dflaky.maxFailureRatePercent)

# ------------------------------------------------------------
# Test impact analysis: com.test.automation.sdk.impact.TestImpactCli maps
# changed source files (via `git diff --name-only <impact.baseRef>`) to the
# test classes transitively affected by that change, using a lightweight
# compiler-free source-reference heuristic -- no bytecode/JaCoCo
# instrumentation required. Run it standalone (not part of `mvn test`):
#   mvn exec:java -Dexec.mainClass="com.test.automation.sdk.impact.TestImpactCli"
# then run just the impacted tests:
#   mvn test -Dsurefire.suiteXmlFiles=test-output/impact/impact_suite.xml
# If any changed file can't be mapped to a known class (non-Java file, or
# outside the indexed source roots), the CLI prints a warning and recommends
# running the full suite instead -- this never silently narrows coverage.
# ------------------------------------------------------------
impact:
  mainSourceDir: "src/main/java"              # (-Dimpact.mainSourceDir)
  testSourceDir: "src/test/java"               # (-Dimpact.testSourceDir)
  testClassNamePattern: "Test_.*"              # regex a class's simple name must match to count as a test (-Dimpact.testClassNamePattern)
  outputSuiteFile: "test-output/impact/impact_suite.xml"  # (-Dimpact.outputSuiteFile)
  baseRef: "HEAD~1"                            # git ref diffed to find changed files (-Dimpact.baseRef)

# ------------------------------------------------------------
# Accessibility Testing (axe-core + WCAG checks)
# Powered by the SDK's built-in accessibility engine.
# Set enabled: true to activate scans automatically after
# every test via the TestNG listener, OR call
# TestBase.runAccessibilityScan() / assertNoAccessibilityViolations()
# directly in test methods.
# Output files go to reporting.accessibilityDir above.
# ------------------------------------------------------------
accessibility:
  checking.enabled: false           # master on/off switch — false by default (opt-in)
  fail.on.violation: false          # legacy: throw on any violation when accessibility.mode is unset
  mode: report-only                 # report-only | fail-test — see "Test Enforcement" below
  failOnSeverity: minor             # minor | moderate | serious | critical — used when mode: fail-test
  wcag.tags: "wcag2a,wcag2aa"       # axe-core tag set to evaluate
  debug: false                      # print [A11Y DEBUG] lines to stdout for troubleshooting
                                    # output directory is controlled by reporting.accessibilityDir above

  # -- Test enforcement ---------------------------------------
  # report-only (default): findings are scanned, suppressed/allowlisted, and
  #   reported (Allure/Extent/Excel/HTML/VPAT) but never change the functional
  #   test result.
  # fail-test: the test fails when a finding's severity meets or exceeds
  #   failOnSeverity (minor fails on ANY qualifying finding — the strictest
  #   setting and the legacy fail.on.violation=true behavior).
  #
  # -- Reporting outputs (all default true whenever checking.enabled: true) ---
  reporting:
    allure: true                    # live Allure steps via AllureA11yReporter
    extent: true                    # live ExtentReports steps via ExtentA11yReporter
    excel: true                     # accessibility-report.xlsx (+ suppression/VPAT sheets)

  # -- Noise reduction & de-duplication ----------------------
  session.noise.threshold: MINOR    # MINOR | MODERATE | SERIOUS | CRITICAL
  session.max.scans.per.url: 1      # max scans per URL per run (0 = unlimited)
  session.dedup.cooldown.ms: 0      # ms between successive scans of the same URL
  session.dedup.dom.fingerprint: true  # skip re-scan when page content unchanged
  session.allowed.rules: ""         # comma-separated axe rule IDs to suppress
  session.allowed.urls: ""          # comma-separated URL fragments to skip entirely

  # -- SPA / async rendering ---------------------------------
  session.spa.poll.interval.ms: 0   # poll for client-side URL changes; ms (0 = off)
  scan.wait.enabled: true           # wait for DOM to settle before scanning
  scan.wait.timeout.ms: 5000        # max wait before scanning anyway
  scan.iframe.max.depth: 3          # levels of nested iFrames to recurse into

  # -- Engine selection (all enabled by default) -------------
  # axe-core (Layer 1) is always on.
  engine.interaction.enabled: true  # keyboard nav, touch targets, focus, text spacing, reflow
  engine.wcag22.enabled: true       # WCAG 2.2: focus appearance, dragging, target size min
  engine.structural.enabled: true   # headings, landmarks, page title, language, link text, dup IDs
  engine.motion.enabled: true       # auto-play media, prefers-reduced-motion

  # -- Dynamic content (modals / dialogs) --------------------
  scan.on.dialog: false             # auto-scan when a modal/dialog/overlay appears
  scan.dialog.poll.interval.ms: 1000
