# =============================================================================
# mobile-config.yaml.example
#
# DEPRECATED / LEGACY COMPATIBILITY CONFIGURATION.
# This standalone-file path exists only as a TEMPORARY migration mechanism
# (Unified SDK Review Priority 2, section 8 of
# docs/proposals/Unified_SDK_Implementation_Review_Findings_2026-09-09.md) and
# will be removed once consumer projects migrate their android.*/ios.*/appium.*
# settings into the unified sdk-config.yaml (see
# src/main/resources/sdk-defaults/sdk-config.yaml.template's "Mobile
# (Appium / Android / iOS) Settings" section, which is the recommended
# location for new projects). If a standalone mobile-config.yaml is present,
# its values are used only when no system property or environment variable
# override is set for the same key -- a system/env override always wins.
#
# Copy this file to mobile-config.yaml (kept out of git, see .gitignore) and
# fill in project-specific values. Read by com.test.automation.sdk.mobile.config.MobileConfigReader.
# =============================================================================

# URL of the local Appium server, used only when running under the "local" Maven
# profile (testInBrowserstack=false). Not used when running against BrowserStack.
appium:
  localUrl: "http://127.0.0.1:4723/"

android:
  # Path to the .apk under test, relative to the project root, used only for local runs.
  # For BrowserStack runs the app is referenced via browserstack.yml's "app: bs://<app-id>" instead.
  appPath: "apps/app-debug.apk"
  # Local emulator/device name (e.g. "Pixel_6_API_34" or a USB-attached device's ADB id).
  deviceName: ""
  automationName: "UiAutomator2"
  # noReset (default true): keep the app's existing install + data/cache between local runs,
  # matching how a developer manually reuses an already-installed, already-warmed-up app on the
  # same emulator/device. Set to "false" if your tests need a guaranteed clean-slate app state
  # every run (e.g. onboarding-flow tests) -- be aware this also forces a cold start that may
  # load remote content noticeably slower/differently than a manually-driven session.
  noReset: "true"
  # fullReset (default false): uninstall + reinstall the app before the session. Rarely needed;
  # noReset=false is usually sufficient for a clean data reset without the reinstall overhead.
  fullReset: "false"
  # httpProxy (optional, unset by default): "host:port" of an HTTP(S) proxy to apply to the
  # emulator/device at session start (UiAutomator2 runs
  # `adb shell settings put global http_proxy ...` automatically when this is set). Needed when
  # the host machine itself sits behind a corporate proxy for internet access -- without it the
  # emulator has no outbound HTTP(S) egress at all, and the app under test will show a generic
  # "network connectivity issue" that is easy to misdiagnose as an app/locator/test bug rather
  # than an environment/network configuration gap. Leave unset on networks with direct internet
  # access.
  # httpProxy: "proxy.example.com:8080"
  # udid (optional, unset by default): exact adb device serial to target (e.g. "emulator-5554"
  # or a physical device's serial such as "R38MA0KYJTT" -- run `adb devices` to list them).
  # "deviceName" above is descriptive only and does NOT select which device Appium uses --
  # with more than one device/emulator attached at once, an unpinned session can silently land
  # on an unintended device (observed to vary run-to-run), which can look like a session-startup
  # or locator failure (wrong app/OS state) when it is actually just the wrong device. Always
  # set this when more than one device/emulator may be attached simultaneously.
  # udid: "emulator-5554"

ios:
  # Path to the .ipa/.app under test, relative to the project root, used only for local runs.
  appPath: "apps/App.ipa"
  # Local simulator/device name (e.g. "iPhone 15").
  deviceName: ""
  automationName: "XCUITest"
  # See android.noReset / android.fullReset above for rationale.
  noReset: "true"
  fullReset: "false"
  # See android.udid above for rationale -- pins the exact simulator/device UDID.
  # udid: "00008030-001A2B3C4D5E6F7G"
